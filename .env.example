# --- Provider selection -------------------------------------------------------
# reviewflow discovers credentials automatically; these are overrides.
#
#   auto        (default) first credentialed provider in preference order
#   codex       OpenAI ChatGPT OAuth  (~/.codex/auth.json or Hermes' auth.json)
#   commandcode commandcode gateway    (~/.commandcode/auth.json)
#   openai      plain OpenAI API key
#
# Check what was found with:   reviewflow providers
# Live-verify it end to end:   reviewflow doctor
# REVIEWFLOW_PROVIDER=auto

# Per-role model overrides. A "provider:model" prefix pins that role to a specific
# backend; a bare name resolves against the active provider.
# REVIEWFLOW_ORCHESTRATOR_MODEL=codex:gpt-5.6-sol
# REVIEWFLOW_REVIEWER_MODEL=commandcode:gpt-5.6-luna
# REVIEWFLOW_EDITOR_MODEL=commandcode:gpt-5.6-sol
# REVIEWFLOW_ADVERSARIAL_MODEL=commandcode:gpt-5.6-sol
# REVIEWFLOW_CHEAP_MODEL=commandcode:deepseek/deepseek-v4-flash
# REVIEWFLOW_VERIFIER_MODEL=commandcode:gpt-5.6-luna

# Point discovery at a different credential store (useful for tests and profiles).
# REVIEWFLOW_CODEX_AUTH_PATH=/path/to/codex/auth.json
# REVIEWFLOW_COMMANDCODE_AUTH_PATH=/path/to/commandcode/auth.json
# HERMES_HOME=/path/to/hermes          # where Hermes keeps its OpenAI OAuth tokens

# --- Plain OpenAI API key (the `openai` provider) -----------------------------
# Only needed if you use the API-key path; the OAuth providers above ignore it.
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# REVIEWFLOW_OPENAI_API_KEY=sk-...     # takes precedence over OPENAI_API_KEY
# REVIEWFLOW_HTTP_TIMEOUT=600

# --- reviewflow configuration -------------------------------------------------
# Every setting below maps to reviewflow.config.Settings.from_env().
# Model defaults per provider live in src/reviewflow/providers/routing.py; the
# verified model matrix is in IMPLEMENTATION_NOTES.md.

# Bounded cost / bounded autonomy
REVIEWFLOW_MAX_REVISION_ROUNDS=2
REVIEWFLOW_MAX_TURNS_PER_AGENT=8
REVIEWFLOW_MAX_REVIEWER_CONCURRENCY=4
REVIEWFLOW_AGENT_TIMEOUT_S=120
REVIEWFLOW_MAX_TRANSIENT_RETRIES=2
REVIEWFLOW_MAX_INVALID_OUTPUT_RETRIES=1
REVIEWFLOW_MAX_TOTAL_TOKENS=400000
REVIEWFLOW_SEMANTIC_CHECKS=

# Workspace / write safety
REVIEWFLOW_WORKSPACE_ROOT=.
REVIEWFLOW_ALLOWED_WRITE_ROOTS=.
REVIEWFLOW_LEDGER_PATH=artifacts/audit.sqlite3
REVIEWFLOW_GENERATED_GLOBS=
REVIEWFLOW_FORBIDDEN_PATTERNS=

# Observability. Sensitive-data tracing is OFF by default: the material under
# review is a document, and traces must not ship its contents to the trace backend.
# When no OpenAI-platform key is present (an OAuth-only setup) the trace processors are
# replaced by the local ledger mirror, so no export is attempted at all.
REVIEWFLOW_TRACING_ENABLED=true
REVIEWFLOW_TRACE_INCLUDE_SENSITIVE_DATA=false
REVIEWFLOW_TRACE_TO_LEDGER=true
